APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=emi
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
MEDIA_SIGNED_URL_TTL_MINUTES=15
MEDIA_MAX_IMAGE_KB=5120
MEDIA_MAX_DOCUMENT_KB=25600
MEDIA_MAX_AUDIO_KB=30720
DICTIONARY_IMPORT_DISK=local
DICTIONARY_IMPORT_MAX_CSV_KB=10240
DICTIONARY_IMPORT_MAX_ZIP_KB=256000
DICTIONARY_IMPORT_MAX_ROWS=10000
DICTIONARY_IMPORT_MAX_AUDIO_FILES=10000
DICTIONARY_IMPORT_MAX_UNCOMPRESSED_KB=512000
DICTIONARY_IMPORT_CHUNK_SIZE=500
QUIZ_MAX_DURATION_MINUTES=240
QUIZ_MAX_ATTEMPTS=10
QUIZ_DEFAULT_FUZZY_THRESHOLD=85

DASHBOARD_DEFAULT_PERIOD_DAYS=30
DASHBOARD_MAX_PERIOD_DAYS=366
DASHBOARD_DEFAULT_PER_PAGE=20
DASHBOARD_MAX_PER_PAGE=100
REPORT_EXPORT_MAX_ROWS=50000
AI_FREE_PROVIDER=none
AI_FREE_API_KEY=
AI_FREE_MODEL=
AI_FREE_TIMEOUT_SECONDS=8
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT_SECONDS=10
AI_VECTOR_RETRIEVAL_ENABLED=false
AI_VECTOR_TOP_K=5
AI_KEYWORD_TOP_K=5
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Isi password admin di environment lokal/production. Jangan commit secret nyata.
EMI_ADMIN_NAME="Administrator EMI"
EMI_ADMIN_EMAIL="admin@example.com"
EMI_ADMIN_PASSWORD=
