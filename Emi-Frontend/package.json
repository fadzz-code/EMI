{
  "name": "emi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=public --project=chromium --project=teacher --project=student --project=cross-role --workers=1",
    "test:e2e:admin": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=chromium --workers=1",
    "test:e2e:teacher": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=teacher --workers=1",
    "test:e2e:student": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=student --workers=1",
    "test:e2e:cross-role": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=cross-role --workers=1",
    "test:e2e:headed": "node --env-file=.env.e2e node_modules/@playwright/test/cli.js test --project=public --project=chromium --project=teacher --project=student --project=cross-role --workers=1 --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
